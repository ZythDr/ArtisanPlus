    <Button name="ArtisanItemTemplate" inherits="TradeSkillItemTemplate" virtual="true">
        <Scripts>
            <OnEnter>
                if Artisan.selectedSkill ~= 0 then
                    GameTooltip:SetOwner(self, "ANCHOR_TOPLEFT")
                    GameTooltip:SetTradeSkillItem(Artisan.selectedSkill, self:GetID())
                    CursorUpdate(self)
                end
            </OnEnter>
            <OnClick>
                HandleModifiedItemClick(GetTradeSkillReagentItemLink(Artisan.selectedSkill, self:GetID()))
            </OnClick>
        </Scripts>
    </Button>
