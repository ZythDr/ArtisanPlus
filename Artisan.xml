                            <Size x="14" y="14"/>
                            <Anchors>
                                <Anchor point="CENTER" x="0" y="-1"/>
                            </Anchors>
                        </PushedTexture>
                        <Scripts>
                            <OnClick>
                                local box = self:GetParent()
                                box:ClearFocus()
                                if box:GetText() == "" then return end
                                box:SetText("")
                            </OnClick>
                        </Scripts>
                    </Button>
                </Frames>
                <Scripts>
                    <OnEnterPressed>
                        self:ClearFocus()
                    </OnEnterPressed>
                    <OnTextChanged>
                        TradeSkillFilter_OnTextChanged(self)
                    </OnTextChanged>
                    <OnEscapePressed>
                        self:ClearFocus()
                    </OnEscapePressed>
                    <OnEditFocusLost>
                        self:HighlightText(0, 0)
                        if string.len(self:GetText()) > 0 then
                            self:AddHistoryLine(self:GetText())
                        end
                    </OnEditFocusLost>
                    <OnEditFocusGained>
                        self:HighlightText()
                    </OnEditFocusGained>
                </Scripts>
            </EditBox>
