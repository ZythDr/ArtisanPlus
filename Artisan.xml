                            ArtisanFrameInputBox:SetNumber(ArtisanFrame.numAvailable)
                            DoTradeSkill(Artisan.selectedSkill, ArtisanFrame.numAvailable)
                            ArtisanFrameInputBox:ClearFocus()
                        end
                    </OnClick>
                </Scripts>
            </Button>
            <Button name="ArtisanFrameDecrementButton">
                <Size x="23" y="22"/>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="ArtisanFrameCreateAllButton" relativePoint="RIGHT" x="3" y="0"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        Artisan.DecrementButton_OnClick(self, button)
                        ArtisanFrameInputBox:ClearFocus()
                    </OnClick>
                </Scripts>
                <NormalTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Up"/>
                <PushedTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Down"/>
                <DisabledTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Disabled"/>
                <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
            </Button>
            <EditBox name="ArtisanFrameInputBox" letters="3" historyLines="0" numeric="true" autoFocus="false">
                <Size x="30" y="20"/>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="ArtisanFrameDecrementButton" relativePoint="RIGHT" x="4" y="0"/>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture name="$parentLeft" file="Interface\Common\Common-Input-Border">
                            <Size x="8" y="20"/>
                            <Anchors>
                                <Anchor point="TOPLEFT" x="-5" y="0"/>
                            </Anchors>
                            <TexCoords left="0" right="0.0625" top="0" bottom="0.625"/>
                        </Texture>
                        <Texture name="$parentRight" file="Interface\Common\Common-Input-Border">
                            <Size x="8" y="20"/>
                            <Anchors>
                                <Anchor point="RIGHT" x="0" y="0"/>
                            </Anchors>
                            <TexCoords left="0.9375" right="1.0" top="0" bottom="0.625"/>
                        </Texture>
                        <Texture name="$parentMiddle" file="Interface\Common\Common-Input-Border">
                            <Size x="10" y="20"/>
                            <Anchors>
                                <Anchor point="LEFT" relativeTo="$parentLeft" relativePoint="RIGHT"/>
                                <Anchor point="RIGHT" relativeTo="$parentRight" relativePoint="LEFT"/>
                            </Anchors>
                            <TexCoords left="0.0625" right="0.9375" top="0" bottom="0.625"/>
                        </Texture>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnEnterPressed>
                        self:ClearFocus()
                    </OnEnterPressed>
                    <OnEscapePressed>
                        self:ClearFocus()
                    </OnEscapePressed>
                    <OnTextChanged>
                        if self:GetText() == "0" then
                            self:SetText("1")
                        end
                    </OnTextChanged> 
                    <OnEditFocusLost>
                        self:HighlightText(0, 0)
                    </OnEditFocusLost>
                    <OnEditFocusGained>
                        self:HighlightText()
                    </OnEditFocusGained>
                </Scripts>
                <FontString inherits="ChatFontNormal"/>
            </EditBox>
            <Button name="ArtisanFrameIncrementButton">
                <Size x="23" y="22"/>
                <Anchors>
                    <Anchor point="RIGHT" relativeTo="ArtisanFrameCreateButton" relativePoint="LEFT" x="-3" y="0"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        Artisan.IncrementButton_OnClick(self, button)
                        ArtisanFrameInputBox:ClearFocus()
                    </OnClick>
                </Scripts>
                <NormalTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Up"/>
                <PushedTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Down"/>
                <DisabledTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Disabled"/>
                <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
            </Button>
            <CheckButton name="ArtisanSortDefault" inherits="OptionsCheckButtonTemplate" id="1">
                <Size x="24" y="24"/>
                <HitRectInsets left="0" right="-50" top="0" bottom="0"/>
                <Anchors>
                    <Anchor point="CENTER" relativeTo="ArtisanSortingLabel" relativePoint="RIGHT" x="18" y="0"/>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        _G[self:GetName().."Text"]:SetText(DEFAULT)
                    </OnLoad>
                    <OnClick>
                        Artisan.SortDefault_OnClick(self, button)
                    </OnClick>
                </Scripts>
            </CheckButton>
            <CheckButton name="ArtisanSortCustom" inherits="OptionsCheckButtonTemplate" id="2">
                <Size x="24" y="24"/>
                <HitRectInsets left="0" right="-40" top="0" bottom="0"/>
                <Anchors>
                    <Anchor point="CENTER" relativeTo="ArtisanSortDefault" relativePoint="RIGHT" x="60" y="0"/>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        _G[self:GetName().."Text"]:SetText(CUSTOM)
                    </OnLoad>
                    <OnClick>
                        Artisan.SortCustom_OnClick(self, button)
                    </OnClick>
                </Scripts>
            </CheckButton>
            <CheckButton name="ArtisanHaveReagents" inherits="OptionsCheckButtonTemplate" id="3">
                <Size x="24" y="24"/>
                <HitRectInsets left="0" right="-80" top="0" bottom="0"/>
                <Anchors>
                    <Anchor point="CENTER" relativeTo="ArtisanSortDefault" relativePoint="BOTTOM" x="0" y="-6"/>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        _G[self:GetName().."Text"]:SetText(CRAFT_IS_MAKEABLE)
                    </OnLoad>
                    <OnClick>
                        Artisan.HaveReagents_OnClick(self, button)
                    </OnClick>
                    <OnEnable>
                        _G[self:GetName().."Text"]:SetTextColor(NORMAL_FONT_COLOR.r, NORMAL_FONT_COLOR.g, NORMAL_FONT_COLOR.b)
                    </OnEnable>
                    <OnDisable>
                        _G[self:GetName().."Text"]:SetTextColor(GRAY_FONT_COLOR.r, GRAY_FONT_COLOR.g, GRAY_FONT_COLOR.b)
                    </OnDisable>
                </Scripts>
            </CheckButton>
            <Button name="ArtisanToggleEditorButton" hidden="true">
                <Size x="20" y="20"/>
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-50" y="-64"/>
                </Anchors>
                <NormalTexture file="Interface\Buttons\UI-GuildButton-PublicNote-Up"/>
                <HighlightTexture file="Interface\Buttons\UI-GuildButton-PublicNote-Disabled" alphaMode="ADD"/>
                <PushedTexture file="Interface\Buttons\UI-GuildButton-PublicNote-Up">
                    <Size x="20" y="20"/>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" x="-1" y="-1"/>
                    </Anchors>
                </PushedTexture>
                <Scripts>
                    <OnClick>
                        Artisan.ToggleEditorButton_OnClick(self, button)
                    </OnClick>
                </Scripts>
            </Button>
            <Button name="ArtisanLinkButton">
                <Size x="32" y="16"/>
                <Anchors>
                    <Anchor point="RIGHT" relativeTo="ArtisanToggleEditorButton" relativePoint="RIGHT" x="-20" y="0"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        if ChatEdit_GetActiveWindow() then
                            ChatEdit_InsertLink(GetTradeSkillListLink())
                        else
                            ChatFrame_OpenChat(GetTradeSkillListLink())
                        end
                    </OnClick>
                    <OnEnter>
                        GameTooltip:SetOwner(self, "ANCHOR_TOPLEFT")
                        GameTooltip:SetText(LINK_TRADESKILL_TOOLTIP, nil, nil, nil, nil, 1)
                        GameTooltip:Show()
                    </OnEnter>
                    <OnLeave function="GameTooltip_Hide"/>
                </Scripts>
                <NormalTexture file="Interface\TradeSkillFrame\UI-TradeSkill-LinkButton">
                    <TexCoords left="0" right="1.0" top="0" bottom="0.5"/>
                </NormalTexture>
                <HighlightTexture file="Interface\TradeSkillFrame\UI-TradeSkill-LinkButton" alphaMode="ADD">
                    <TexCoords left="0" right="1.0" top="0.5" bottom="1.0"/>
                </HighlightTexture>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad>
                Artisan.OnLoad(self)
            </OnLoad>
            <OnEvent>
                Artisan.OnEvent(self, event, arg1)
            </OnEvent>
            <OnShow>
                ArtisanFrameInputBox:SetNumber(1)
                PlaySound("igCharacterInfoOpen")
            </OnShow>
            <OnHide>
                Artisan.currentTab = nil
                CloseTradeSkill()
                ArtisanEditor:Hide()
                PlaySound("igCharacterInfoClose")
            </OnHide>
            <OnMouseWheel>
                return
            </OnMouseWheel>
        </Scripts>
    </Frame>
</Ui>