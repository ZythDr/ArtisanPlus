<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <Script file="ArtisanEditor.lua"/>
    <Button name="ArtisanEditorButtonLeftTemplate" virtual="true">
        <Size x="293" y="16"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentHighlight" file="Interface\Buttons\UI-Listbox-Highlight2" parentKey="Highlight" setAllPoints="true" hidden="true" alpha="0.5"/>
            </Layer>
            <Layer level="ARTWORK">
                <Texture name="$parentIcon" parentKey="Icon">
                    <Size x="16" y="16"/>
                    <Anchors>
                        <Anchor point="LEFT" x="3" y="0"/>
                    </Anchors>
                    <TexCoords left="0.078125" right="0.90625" top="0.078125" bottom="0.90625"/>
                </Texture>
            </Layer>
        </Layers>
        <ButtonText name="$parentText" parentKey="Text">
            <Size x="270" y="16"/>
            <Anchors>
                <Anchor point="LEFT" relativeTo="$parentIcon" relativePoint="RIGHT" x="2" y="1"/>
            </Anchors>
        </ButtonText>
        <NormalFont style="GameFontNormalLeft"/>
		<HighlightFont style="GameFontHighlightLeft"/>
		<DisabledFont style="GameFontDisableLeft"/>
        <Scripts>
            <OnLoad>
				self:SetFrameLevel(self:GetFrameLevel() + 1)
			</OnLoad>
            <OnClick>
                Artisan.EditorButtonLeft_OnClick(self, button)
            </OnClick>
        </Scripts>
    </Button>
    <Button name="ArtisanEditorButtonRightTemplate" inherits="ArtisanEditorButtonLeftTemplate" virtual="true">
        <Scripts>
            <OnClick>
                Artisan.EditorButtonRight_OnClick(self, button)
            </OnClick>
        </Scripts>
    </Button>
    <Frame name="ArtisanEditor" parent="UIParent" hidden="true" movable="true" toplevel="true" enableMouse="true">
        <Size x="610" y="505"/>
        <Anchors>
            <Anchor point="TOP" x="0" y="-104"/>
        </Anchors>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
            <BackgroundInsets left="5" right="5" top="5" bottom="5"/>
            <TileSize val="32"/>
            <EdgeSize val="28"/>
            <Color r="0" g="0" b="0" a="1"/>
        </Backdrop>
        <Layers>
            <Layer level="ARTWORK">
                <Texture name="ArtisanEditorHeader" file="Interface\DialogFrame\UI-DialogBox-Header">
                    <Size x="300" y="64"/>
                    <Anchors>
                        <Anchor point="TOP" x="0" y="16"/>
                    </Anchors>
                </Texture>
                <FontString inherits="GameFontNormal" text="Custom Categories">
                    <Anchors>
                        <Anchor point="TOP" relativeTo="ArtisanEditorHeader" x="0" y="-14"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button name="ArtisanEditorCloseButton" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-5" y="-5"/>
                </Anchors>
            </Button>
            <ScrollFrame name="ArtisanEditorScrollFrameLeft" inherits="HybridScrollFrameTemplate">
                <Size x="240" y="432"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="25" y="-50"/>
                </Anchors>
                <Frames>
                    <Slider name="$parentScrollBar" inherits="HybridScrollBarTemplate" parentKey="scrollBar">
                        <Anchors>
                            <Anchor point="TOPLEFT" relativePoint="TOPRIGHT" x="0" y="-15"/>
                            <Anchor point="BOTTOMLEFT" relativePoint="BOTTOMRIGHT" x="0" y="14"/>
                        </Anchors>
                        <Scripts>
                            <OnLoad>
                                local name = self:GetName()
                                _G[name.."BG"]:Hide()
                                _G[name.."Top"]:Hide()
                                _G[name.."Bottom"]:Hide()
                                _G[name.."Middle"]:Hide()
                                -- self.doNotHide = true
                            </OnLoad>
                        </Scripts>
                    </Slider>
                    <Frame name="$parentBorder">
                        <Anchors>
                            <Anchor point="TOPLEFT" x="-5" y="5"/>
                            <Anchor point="BOTTOMRIGHT" x="25" y="-5"/>
                        </Anchors>
                        <Backdrop edgeFile="Interface\Tooltips\UI-Tooltip-Border">
                            <EdgeSize val="16"/>
                        </Backdrop>
                    </Frame>
                </Frames>
                <Scripts>
                    <OnLoad>
                        HybridScrollFrame_OnLoad(self)
                        self.update = Artisan.EditorScrollFrameLeft_Update
                        HybridScrollFrame_CreateButtons(self, "ArtisanEditorButtonLeftTemplate")
                    </OnLoad>
                    <OnShow>
                        Artisan.EditorScrollFrameLeft_Update()
                    </OnShow>
                </Scripts>
            </ScrollFrame>
            <Button name="ArtisanEditorMoveRight">
                <Size x="32" y="32"/>
                <Anchors>
                    <Anchor point="CENTER" x="0" y="20"/>
                </Anchors>
                <NormalTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Up"/>
                <PushedTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Down"/>
                <DisabledTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Disabled"/>
                <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
                <Scripts>
                    <OnClick>
                        Artisan.EditorMoveRight_OnClick(self, button)
                    </OnClick>
                </Scripts>
            </Button>
            <Button name="ArtisanEditorMoveLeft">
                <Size x="32" y="32"/>
                <Anchors>
                    <Anchor point="CENTER" x="0" y="-20"/>
                </Anchors>
				<NormalTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Up"/>
				<PushedTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Down"/>
				<DisabledTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Disabled"/>
				<HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
                <Scripts>
                    <OnClick>
                        Artisan.EditorMoveLeft_OnClick(self, button)
                    </OnClick>
                </Scripts>
            </Button>
            <ScrollFrame name="ArtisanEditorScrollFrameRight" inherits="HybridScrollFrameTemplate">
                <Size x="240" y="416"/>
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-45" y="-66"/>
                </Anchors>
                <Frames>
                    <Slider name="$parentScrollBar" inherits="HybridScrollBarTemplate" parentKey="scrollBar">
                        <Anchors>
                            <Anchor point="TOPLEFT" relativePoint="TOPRIGHT" x="0" y="-15"/>
                            <Anchor point="BOTTOMLEFT" relativePoint="BOTTOMRIGHT" x="0" y="14"/>
                        </Anchors>
                        <Scripts>
                            <OnLoad>
                                local name = self:GetName()
                                _G[name.."BG"]:Hide()
                                _G[name.."Top"]:Hide()
                                _G[name.."Bottom"]:Hide()
                                _G[name.."Middle"]:Hide()
                                -- self.doNotHide = true
                            </OnLoad>
                        </Scripts>
                    </Slider>
                    <Frame name="$parentBorder">
                        <Anchors>
                            <Anchor point="TOPLEFT" x="-5" y="5"/>
                            <Anchor point="BOTTOMRIGHT" x="25" y="-5"/>
                        </Anchors>
                        <Backdrop edgeFile="Interface\Tooltips\UI-Tooltip-Border">
                            <EdgeSize val="16"/>
                        </Backdrop>
                    </Frame>
                </Frames>
                <Scripts>
                    <OnLoad>
                        HybridScrollFrame_OnLoad(self)
                        self.update = Artisan.EditorScrollFrameRight_Update
                        HybridScrollFrame_CreateButtons(self, "ArtisanEditorButtonRightTemplate")
                    </OnLoad>
                    <OnShow>
                        Artisan.EditorScrollFrameRight_Update()
                    </OnShow>
                </Scripts>
            </ScrollFrame>
            <EditBox name="ArtisanEditorSearchBox" inherits="InputBoxTemplate" autoFocus="false">
                <Size x="190" y="32"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativeTo="ArtisanEditorScrollFrameLeftBorder" relativePoint="TOPLEFT" x="6" y="-5"/>
                </Anchors>
                <FontString name="$parentText" parentKey="text" inherits="ChatFontNormal"/>
                <TextInsets left="15" right="8" top="0" bottom="0"/>
                <Layers>
                    <Layer level="BORDER">
                        <Texture name="$parentIcon" file="Interface\AddOns\Artisan\Textures\UI-SearchBox-Icon" alpha="0.6">
                            <Size x="14" y="14"/>
                            <Anchors>
                                <Anchor point="LEFT" x="2" y="-2"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <Frames>
                    <Button name="$parentClearButton" alpha="0.6">
                        <Size x="14" y="14"/>
                        <Anchors>
                            <Anchor point="RIGHT" x="-3" y="0"/>
                        </Anchors>
                        <NormalTexture file="Interface\AddOns\Artisan\Textures\UI-SearchBox-Clear"/>
                        <HighlightTexture file="Interface\AddOns\Artisan\Textures\UI-SearchBox-Clear" alphaMode="ADD" alpha="0.6"/>
                        <PushedTexture file="Interface\AddOns\Artisan\Textures\UI-SearchBox-Clear" alpha="0.6">
                            <Size x="14" y="14"/>
                            <Anchors>
                                <Anchor point="CENTER" x="0" y="-1"/>
                            </Anchors>
                        </PushedTexture>
                        <Scripts>
                            <OnClick>
                                local box = self:GetParent()
                                box:ClearFocus()
                                box:SetText("")
                            </OnClick>
                            <OnEnter>
                                self:SetAlpha(1)
                            </OnEnter>
                            <OnLeave>
                                GameTooltip:Hide()
                                self:SetAlpha(0.6)
                            </OnLeave>
                        </Scripts>
                    </Button>
                </Frames>
                <Scripts>
                    <OnEnterPressed>
                        self:ClearFocus()
                    </OnEnterPressed>
                    <OnEscapePressed>
                        self:ClearFocus()
                    </OnEscapePressed>
                    <OnTextChanged>
                        Artisan.EditorSearchBox_OnTextChanged(self, userInput)
                    </OnTextChanged> 
                    <OnEditFocusGained>
                        self:HighlightText()
                    </OnEditFocusGained>
                    <OnEditFocusLost>
                        self:HighlightText(0, 0)
                    </OnEditFocusLost>
                </Scripts>
            </EditBox>
            <Button name="ArtisanEditorCreateHeader" inherits="UIPanelButtonTemplate" text="CREATE">
                <Size x="60" y="22"/>
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-225" y="-35"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        StaticPopup_Show("ARTISAN_HEADER_CREATE")
                    </OnClick>
                </Scripts>
            </Button>
            <Button name="ArtisanEditorDeleteHeader" inherits="UIPanelButtonTemplate" text="DELETE">
                <Size x="60" y="22"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="ArtisanEditorCreateHeader" relativePoint="TOPRIGHT" x="2" y="0"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        Artisan.DeleteHeader()
                    </OnClick>
                </Scripts>
            </Button>
            <Button name="ArtisanEditorRenameHeader" inherits="UIPanelButtonTemplate" text="Rename">
                <Size x="60" y="22"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="ArtisanEditorDeleteHeader" relativePoint="TOPRIGHT" x="2" y="0"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        StaticPopup_Show("ARTISAN_HEADER_RENAME")
                    </OnClick>
                </Scripts>
            </Button>
            <Button name="AdrtisanEditorMoveUp">
                <Size x="28" y="28"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="ArtisanEditorRenameHeader" relativePoint="TOPRIGHT" x="8" y="3"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        Artisan.EditorMoveUp_OnClick(self, button)
                    </OnClick>
                </Scripts>
                <NormalTexture file="Interface\ChatFrame\UI-ChatIcon-ScrollUp-Up"/>
                <PushedTexture file="Interface\ChatFrame\UI-ChatIcon-ScrollUp-Down"/>
                <DisabledTexture file="Interface\ChatFrame\UI-ChatIcon-ScrollUp-Disabled"/>
                <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
            </Button>
            <Button name="AdrtisanEditorMoveDown">
                <Size x="28" y="28"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="AdrtisanEditorMoveUp" relativePoint="TOPRIGHT" x="0" y="0"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        Artisan.EditorMoveDown_OnClick(self, button)
                    </OnClick>
                </Scripts>
                <NormalTexture file="Interface\ChatFrame\UI-ChatIcon-ScrollDown-Up"/>
                <PushedTexture file="Interface\ChatFrame\UI-ChatIcon-ScrollDown-Down"/>
                <DisabledTexture file="Interface\ChatFrame\UI-ChatIcon-ScrollDown-Disabled"/>
                <HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad>
                self:RegisterForDrag("LeftButton")
            </OnLoad>
            <OnShow>
                Artisan.UpdateEditor()
                Artisan.EnableControls(false)
            </OnShow>
            <OnHide>
                Artisan.UpdateFrame()
                StaticPopup_Hide("ARTISAN_HEADER_RENAME")
                StaticPopup_Hide("ARTISAN_HEADER_CREATE")
                Artisan.EnableControls(true)
            </OnHide>
            <OnDragStart>
                self:StartMoving()
            </OnDragStart>
            <OnDragStop>
                self:StopMovingOrSizing()
            </OnDragStop>
        </Scripts>
    </Frame>
</Ui>